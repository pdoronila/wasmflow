        "width": 1920,
        "height": 1080,
        "format": "rgba8",
        "depth": true,
        "multisample": 4
      }
    },
    {
      "id": "base_color",
      "component_id": "graphics:color-rgb",
      "display_name": "Material Color",
      "position": { "x": 100.0, "y": 750.0 },
      "inputs": {
        "r": 0.8,
        "g": 0.3,
        "b": 0.2
      }
    },
    {
      "id": "shader_preview",
      "component_id": "builtin:graphics:shader-preview",
