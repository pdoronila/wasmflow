      "component_id": "graphics:primitive-sphere",
      "display_name": "Sphere Geometry",
      "position": { "x": 100.0, "y": 100.0 },
      "inputs": {
        "radius": 1.5,
        "segments": 32,
        "rings": 16
      }
    },
    {
      "id": "camera_pos",
      "component_id": "graphics:vec3-construct",
      "display_name": "Camera Position",
      "position": { "x": 100.0, "y": 300.0 },
      "inputs": {
        "x": 0.0,
        "y": 3.0,
        "z": 8.0
      }
    },
    {
      "id": "camera_tgt",
      "component_id": "graphics:vec3-construct",
      "display_name": "Look At",
      "position": { "x": 100.0, "y": 450.0 },
      "inputs": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      }
    },
    {
      "id": "camera_up",
      "component_id": "graphics:vec3-construct",
      "display_name": "Up Vector",
      "position": { "x": 100.0, "y": 600.0 },
      "inputs": {
        "x": 0.0,
        "y": 1.0,
        "z": 0.0
      }
    },
    {
      "id": "camera",
      "component_id": "graphics:perspective-camera",
      "display_name": "Perspective Camera",
      "position": { "x": 400.0, "y": 350.0 },
      "inputs": {
        "fov": 45.0,
        "aspect_ratio": 1.777778,
        "near": 0.1,
        "far": 100.0
      }
    },
    {
      "id": "render_target",
      "component_id": "graphics:render-target",
      "display_name": "Render Target Config",
      "position": { "x": 700.0, "y": 200.0 },
